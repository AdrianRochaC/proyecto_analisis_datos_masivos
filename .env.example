# ==========================================
# Plantilla de Variables de Entorno (.env.example)
# Copiar este archivo a .env antes de desplegar:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
# ==========================================

# Credenciales de MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=cambiar_por_tu_password_seguro
MONGO_PORT=27017

# Base de datos y colección
MONGO_DB_NAME=fifa_analytics_db
MONGO_COLLECTION=jugadores

# Mongo Express (Consola Web de Auditoría)
MONGO_EXPRESS_PORT=8081

# Streamlit (Dashboard Ejecutivo)
STREAMLIT_PORT=8501

